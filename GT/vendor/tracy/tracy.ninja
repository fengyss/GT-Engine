# tracy project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_gcc
  command = gcc $cflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C source $in

rule cxx_gcc
  command = g++ $cxxflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C++ source $in

rule rc_gcc
  command = windres -i $in -o $out $resflags
  description = Compiling resource $in

rule ar_gcc
  command = ar -rcs $out $in
  description = Archiving static library $out

rule pch_gcc
  command = g++ -x c++-header $cflags -o $out -MD -MF $out.d -c $in
  description = Generating precompiled header $in
  depfile = $out.d

rule copy
  command = cp -f $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: tracy_Debug

cflags_tracy_Debug = -m64 -fPIC -g -D"TRACY_ENABLE" -IGT/vendor/tracy/public/tracy
cxxflags_tracy_Debug = -m64 -fPIC -g -std=c++17 -D"TRACY_ENABLE" -IGT/vendor/tracy/public/tracy
ldflags_tracy_Debug = -m64 -L/usr/lib64
objdir_tracy_Debug = ../../../bin-int/Debug-linux-x86_64/tracy
targetdir_tracy_Debug = ../../../bin/Debug-linux-x86_64/tracy
target_tracy_Debug = libtracy.a

build bin-int/Debug-linux-x86_64/tracy/TracyClient.o: cxx_gcc GT/vendor/tracy/public/TracyClient.cpp
  cxxflags = $cxxflags_tracy_Debug
build bin/Debug-linux-x86_64/tracy/libtracy.a: ar_gcc bin-int/Debug-linux-x86_64/tracy/TracyClient.o

# Configuration: tracy_Release

cflags_tracy_Release = -m64 -O2 -fPIC -D"TRACY_ENABLE" -IGT/vendor/tracy/public/tracy
cxxflags_tracy_Release = -m64 -O2 -fPIC -std=c++17 -D"TRACY_ENABLE" -IGT/vendor/tracy/public/tracy
ldflags_tracy_Release = -m64 -s -L/usr/lib64
objdir_tracy_Release = ../../../bin-int/Release-linux-x86_64/tracy
targetdir_tracy_Release = ../../../bin/Release-linux-x86_64/tracy
target_tracy_Release = libtracy.a

build bin-int/Release-linux-x86_64/tracy/TracyClient.o: cxx_gcc GT/vendor/tracy/public/TracyClient.cpp
  cxxflags = $cxxflags_tracy_Release
build bin/Release-linux-x86_64/tracy/libtracy.a: ar_gcc bin-int/Release-linux-x86_64/tracy/TracyClient.o

# Configuration: tracy_Dist

cflags_tracy_Dist = -m64 -fPIC -D"TRACY_ENABLE" -IGT/vendor/tracy/public/tracy
cxxflags_tracy_Dist = -m64 -fPIC -std=c++17 -D"TRACY_ENABLE" -IGT/vendor/tracy/public/tracy
ldflags_tracy_Dist = -m64 -s -L/usr/lib64
objdir_tracy_Dist = ../../../bin-int/Dist-linux-x86_64/tracy
targetdir_tracy_Dist = ../../../bin/Dist-linux-x86_64/tracy
target_tracy_Dist = libtracy.a

build bin-int/Dist-linux-x86_64/tracy/TracyClient.o: cxx_gcc GT/vendor/tracy/public/TracyClient.cpp
  cxxflags = $cxxflags_tracy_Dist
build bin/Dist-linux-x86_64/tracy/libtracy.a: ar_gcc bin-int/Dist-linux-x86_64/tracy/TracyClient.o

# Build targets

build tracy_Debug: phony bin/Debug-linux-x86_64/tracy/libtracy.a
build tracy_Release: phony bin/Release-linux-x86_64/tracy/libtracy.a
build tracy_Dist: phony bin/Dist-linux-x86_64/tracy/libtracy.a

# Project phony targets

build tracy: phony bin/Debug-linux-x86_64/tracy/libtracy.a

