# json project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_gcc
  command = gcc $cflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C source $in

rule cxx_gcc
  command = g++ $cxxflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C++ source $in

rule rc_gcc
  command = windres -i $in -o $out $resflags
  description = Compiling resource $in

rule ar_gcc
  command = ar -rcs $out $in
  description = Archiving static library $out

rule pch_gcc
  command = g++ -x c++-header $cflags -o $out -MD -MF $out.d -c $in
  description = Generating precompiled header $in
  depfile = $out.d

rule copy
  command = cp -f $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: json_Debug

cflags_json_Debug = -m64 -g
cxxflags_json_Debug = -m64 -g -std=c++17
ldflags_json_Debug = -m64 -L/usr/lib64
objdir_json_Debug = ../../../bin-int/Debug-linux-x86_64/json
targetdir_json_Debug = ../../../bin/Debug-linux-x86_64/json
target_json_Debug = libjson.a


# Configuration: json_Release

cflags_json_Release = -m64 -O2
cxxflags_json_Release = -m64 -O2 -std=c++17
ldflags_json_Release = -m64 -s -L/usr/lib64
objdir_json_Release = ../../../bin-int/Release-linux-x86_64/json
targetdir_json_Release = ../../../bin/Release-linux-x86_64/json
target_json_Release = libjson.a


# Configuration: json_Dist

cflags_json_Dist = -m64
cxxflags_json_Dist = -m64 -std=c++17
ldflags_json_Dist = -m64 -s -L/usr/lib64
objdir_json_Dist = ../../../bin-int/Dist-linux-x86_64/json
targetdir_json_Dist = ../../../bin/Dist-linux-x86_64/json
target_json_Dist = libjson.a


# Build targets

build json_Debug: phony bin/Debug-linux-x86_64/json/libjson.a
build json_Release: phony bin/Release-linux-x86_64/json/libjson.a
build json_Dist: phony bin/Dist-linux-x86_64/json/libjson.a

# Project phony targets

build json: phony bin/Debug-linux-x86_64/json/libjson.a

