# json project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_msc
  command = cl $cflags /nologo /showIncludes -c /Tc$in /Fo$out
  deps = msvc
  description = Compiling C source $in

rule cxx_msc
  command = cl $cxxflags /nologo /showIncludes -c /Tp$in /Fo$out
  deps = msvc
  description = Compiling C++ source $in

rule rc_msc
  command = rc /nologo /fo$out $in $resflags
  description = Compiling resource $in

rule ar_msc
  command = lib $in /nologo -OUT:$out
  description = Archiving static library $out

rule pch_msc
  command = cl /nologo /Yc$pchheader /Fp$out /Fo$objdir/ $cflags /c $in
  description = Generating precompiled header $pchheader

rule copy
  command = copy /B /Y $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: json_Debug

cflags_json_Debug = /MTd /Z7
cxxflags_json_Debug = /MTd /Z7 /std:c++17 /EHsc
ldflags_json_Debug = /NOLOGO
objdir_json_Debug = bin-int/Debug-windows-x86_64/json
targetdir_json_Debug = bin/Debug-windows-x86_64/json
target_json_Debug = json.lib


# Configuration: json_Release

cflags_json_Release = /Ot /MT
cxxflags_json_Release = /Ot /MT /std:c++17 /EHsc
ldflags_json_Release = /NOLOGO
objdir_json_Release = bin-int/Release-windows-x86_64/json
targetdir_json_Release = bin/Release-windows-x86_64/json
target_json_Release = json.lib


# Configuration: json_Dist

cflags_json_Dist = /MT
cxxflags_json_Dist = /MT /std:c++17 /EHsc
ldflags_json_Dist = /NOLOGO
objdir_json_Dist = bin-int/Dist-windows-x86_64/json
targetdir_json_Dist = bin/Dist-windows-x86_64/json
target_json_Dist = json.lib


# Build targets

build json_Debug: phony GT/vendor/json/bin/Debug-windows-x86_64/json/json.lib
build json_Release: phony GT/vendor/json/bin/Release-windows-x86_64/json/json.lib
build json_Dist: phony GT/vendor/json/bin/Dist-windows-x86_64/json/json.lib

# Project phony targets

build json: phony GT/vendor/json/bin/Debug-windows-x86_64/json/json.lib

