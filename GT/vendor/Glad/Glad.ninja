# Glad project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_msc
  command = cl $cflags /nologo /showIncludes -c /Tc$in /Fo$out
  deps = msvc
  description = Compiling C source $in

rule cxx_msc
  command = cl $cxxflags /nologo /showIncludes -c /Tp$in /Fo$out
  deps = msvc
  description = Compiling C++ source $in

rule rc_msc
  command = rc /nologo /fo$out $in $resflags
  description = Compiling resource $in

rule ar_msc
  command = lib $in /nologo -OUT:$out
  description = Archiving static library $out

rule pch_msc
  command = cl /nologo /Yc$pchheader /Fp$out /Fo$objdir/ $cflags /c $in
  description = Generating precompiled header $pchheader

rule copy
  command = copy /B /Y $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: Glad_Debug

cflags_Glad_Debug = /MDd /Z7 /IGT/vendor/Glad/include
cxxflags_Glad_Debug = /MDd /Z7 /EHsc /IGT/vendor/Glad/include
ldflags_Glad_Debug = /NOLOGO
objdir_Glad_Debug = bin-int/Debug-windows-x86_64/Glad
targetdir_Glad_Debug = bin/Debug-windows-x86_64/Glad
target_Glad_Debug = Glad.lib

build GT/vendor/Glad/bin-int/Debug-windows-x86_64/Glad/glad.obj: cc_msc GT/vendor/Glad/src/glad.c
  cflags = $cflags_Glad_Debug
build GT/vendor/Glad/bin/Debug-windows-x86_64/Glad/Glad.lib: ar_msc GT/vendor/Glad/bin-int/Debug-windows-x86_64/Glad/glad.obj

# Configuration: Glad_Release

cflags_Glad_Release = /Ot /MD /IGT/vendor/Glad/include
cxxflags_Glad_Release = /Ot /MD /EHsc /IGT/vendor/Glad/include
ldflags_Glad_Release = /NOLOGO
objdir_Glad_Release = bin-int/Release-windows-x86_64/Glad
targetdir_Glad_Release = bin/Release-windows-x86_64/Glad
target_Glad_Release = Glad.lib

build GT/vendor/Glad/bin-int/Release-windows-x86_64/Glad/glad.obj: cc_msc GT/vendor/Glad/src/glad.c
  cflags = $cflags_Glad_Release
build GT/vendor/Glad/bin/Release-windows-x86_64/Glad/Glad.lib: ar_msc GT/vendor/Glad/bin-int/Release-windows-x86_64/Glad/glad.obj

# Configuration: Glad_Dist

cflags_Glad_Dist = /MD /IGT/vendor/Glad/include
cxxflags_Glad_Dist = /MD /EHsc /IGT/vendor/Glad/include
ldflags_Glad_Dist = /NOLOGO
objdir_Glad_Dist = bin-int/Dist-windows-x86_64/Glad
targetdir_Glad_Dist = bin/Dist-windows-x86_64/Glad
target_Glad_Dist = Glad.lib

build GT/vendor/Glad/bin-int/Dist-windows-x86_64/Glad/glad.obj: cc_msc GT/vendor/Glad/src/glad.c
  cflags = $cflags_Glad_Dist
build GT/vendor/Glad/bin/Dist-windows-x86_64/Glad/Glad.lib: ar_msc GT/vendor/Glad/bin-int/Dist-windows-x86_64/Glad/glad.obj

# Build targets

build Glad_Debug: phony GT/vendor/Glad/bin/Debug-windows-x86_64/Glad/Glad.lib
build Glad_Release: phony GT/vendor/Glad/bin/Release-windows-x86_64/Glad/Glad.lib
build Glad_Dist: phony GT/vendor/Glad/bin/Dist-windows-x86_64/Glad/Glad.lib

# Project phony targets

build Glad: phony GT/vendor/Glad/bin/Debug-windows-x86_64/Glad/Glad.lib

