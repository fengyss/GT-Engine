# Glad project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_gcc
  command = gcc $cflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C source $in

rule cxx_gcc
  command = g++ $cxxflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C++ source $in

rule rc_gcc
  command = windres -i $in -o $out $resflags
  description = Compiling resource $in

rule ar_gcc
  command = ar -rcs $out $in
  description = Archiving static library $out

rule pch_gcc
  command = gcc -x c-header $cflags -o $out -MD -MF $out.d -c $in
  description = Generating precompiled header $in
  depfile = $out.d

rule copy
  command = cp -f $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: Glad_Debug

cflags_Glad_Debug = -m64 -g -IGT/vendor/Glad/include
cxxflags_Glad_Debug = -m64 -g -IGT/vendor/Glad/include
ldflags_Glad_Debug = -m64 -L/usr/lib64
objdir_Glad_Debug = ../../../bin-int/Debug-linux-x86_64/Glad
targetdir_Glad_Debug = ../../../bin/Debug-linux-x86_64/Glad
target_Glad_Debug = libGlad.a

build bin-int/Debug-linux-x86_64/Glad/glad.o: cc_gcc GT/vendor/Glad/src/glad.c
  cflags = $cflags_Glad_Debug
build bin/Debug-linux-x86_64/Glad/libGlad.a: ar_gcc bin-int/Debug-linux-x86_64/Glad/glad.o

# Configuration: Glad_Release

cflags_Glad_Release = -m64 -O2 -IGT/vendor/Glad/include
cxxflags_Glad_Release = -m64 -O2 -IGT/vendor/Glad/include
ldflags_Glad_Release = -m64 -s -L/usr/lib64
objdir_Glad_Release = ../../../bin-int/Release-linux-x86_64/Glad
targetdir_Glad_Release = ../../../bin/Release-linux-x86_64/Glad
target_Glad_Release = libGlad.a

build bin-int/Release-linux-x86_64/Glad/glad.o: cc_gcc GT/vendor/Glad/src/glad.c
  cflags = $cflags_Glad_Release
build bin/Release-linux-x86_64/Glad/libGlad.a: ar_gcc bin-int/Release-linux-x86_64/Glad/glad.o

# Configuration: Glad_Dist

cflags_Glad_Dist = -m64 -IGT/vendor/Glad/include
cxxflags_Glad_Dist = -m64 -IGT/vendor/Glad/include
ldflags_Glad_Dist = -m64 -s -L/usr/lib64
objdir_Glad_Dist = ../../../bin-int/Dist-linux-x86_64/Glad
targetdir_Glad_Dist = ../../../bin/Dist-linux-x86_64/Glad
target_Glad_Dist = libGlad.a

build bin-int/Dist-linux-x86_64/Glad/glad.o: cc_gcc GT/vendor/Glad/src/glad.c
  cflags = $cflags_Glad_Dist
build bin/Dist-linux-x86_64/Glad/libGlad.a: ar_gcc bin-int/Dist-linux-x86_64/Glad/glad.o

# Build targets

build Glad_Debug: phony bin/Debug-linux-x86_64/Glad/libGlad.a
build Glad_Release: phony bin/Release-linux-x86_64/Glad/libGlad.a
build Glad_Dist: phony bin/Dist-linux-x86_64/Glad/libGlad.a

# Project phony targets

build Glad: phony bin/Debug-linux-x86_64/Glad/libGlad.a

