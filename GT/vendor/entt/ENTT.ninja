# ENTT project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_msc
  command = cl $cflags /nologo /showIncludes -c /Tc$in /Fo$out
  deps = msvc
  description = Compiling C source $in

rule cxx_msc
  command = cl $cxxflags /nologo /showIncludes -c /Tp$in /Fo$out
  deps = msvc
  description = Compiling C++ source $in

rule rc_msc
  command = rc /nologo /fo$out $in $resflags
  description = Compiling resource $in

rule ar_msc
  command = lib $in /nologo -OUT:$out
  description = Archiving static library $out

rule pch_msc
  command = cl /nologo /Yc$pchheader /Fp$out /Fo$objdir/ $cflags /c $in
  description = Generating precompiled header $pchheader

rule copy
  command = copy /B /Y $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: ENTT_Debug

cflags_ENTT_Debug = /MTd /Z7
cxxflags_ENTT_Debug = /MTd /Z7 /std:c++17 /EHsc
ldflags_ENTT_Debug = /NOLOGO
objdir_ENTT_Debug = bin-int/Debug-windows-x86_64/ENTT
targetdir_ENTT_Debug = bin/Debug-windows-x86_64/ENTT
target_ENTT_Debug = ENTT.lib


# Configuration: ENTT_Release

cflags_ENTT_Release = /Ot /MT
cxxflags_ENTT_Release = /Ot /MT /std:c++17 /EHsc
ldflags_ENTT_Release = /NOLOGO
objdir_ENTT_Release = bin-int/Release-windows-x86_64/ENTT
targetdir_ENTT_Release = bin/Release-windows-x86_64/ENTT
target_ENTT_Release = ENTT.lib


# Configuration: ENTT_Dist

cflags_ENTT_Dist = /MT
cxxflags_ENTT_Dist = /MT /std:c++17 /EHsc
ldflags_ENTT_Dist = /NOLOGO
objdir_ENTT_Dist = bin-int/Dist-windows-x86_64/ENTT
targetdir_ENTT_Dist = bin/Dist-windows-x86_64/ENTT
target_ENTT_Dist = ENTT.lib


# Build targets

build ENTT_Debug: phony GT/vendor/entt/bin/Debug-windows-x86_64/ENTT/ENTT.lib
build ENTT_Release: phony GT/vendor/entt/bin/Release-windows-x86_64/ENTT/ENTT.lib
build ENTT_Dist: phony GT/vendor/entt/bin/Dist-windows-x86_64/ENTT/ENTT.lib

# Project phony targets

build ENTT: phony GT/vendor/entt/bin/Debug-windows-x86_64/ENTT/ENTT.lib

