  cxxflags = $cxxflags_ImGui_Dist
build GT/vendor/ImGui/bin-int/Dist-windows-x86_64/ImGui/imgui_widgets.obj: cxx_msc GT/vendor/ImGui/imgui_widgets.cpp
  cxxflags = $cxxflags_ImGui_Dist
build GT/vendor/ImGui/bin/Dist-windows-x86_64/ImGui/ImGui.lib: ar_msc GT/vendor/ImGui/bin-int/Dist-windows-x86_64/ImGui/imgui.obj GT/vendor/ImGui/bin-int/Dist-windows-x86_64/ImGui/imgui_demo.obj GT/vendor/ImGui/bin-int/Dist-windows-x86_64/ImGui/imgui_draw.obj GT/vendor/ImGui/bin-int/Dist-windows-x86_64/ImGui/imgui_tables.obj GT/vendor/ImGui/bin-int/Dist-windows-x86_64/ImGui/imgui_widgets.obj

# Build targets

build ImGui_Debug: phony GT/vendor/ImGui/bin/Debug-windows-x86_64/ImGui/ImGui.lib
build ImGui_Release: phony GT/vendor/ImGui/bin/Release-windows-x86_64/ImGui/ImGui.lib
build ImGui_Dist: phony GT/vendor/ImGui/bin/Dist-windows-x86_64/ImGui/ImGui.lib

# Project phony targets

build ImGui: phony GT/vendor/ImGui/bin/Debug-windows-x86_64/ImGui/ImGui.lib

