# ImGui project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_msc
  command = cl $cflags /nologo /showIncludes -c /Tc$in /Fo$out
  deps = msvc
  description = Compiling C source $in

rule cxx_msc
  command = cl $cxxflags /nologo /showIncludes -c /Tp$in /Fo$out
  deps = msvc
  description = Compiling C++ source $in

rule rc_msc
  command = rc /nologo /fo$out $in $resflags
  description = Compiling resource $in

rule ar_msc
  command = lib $in /nologo -OUT:$out
  description = Archiving static library $out

rule pch_msc
  command = cl /nologo /Yc$pchheader /Fp$out /Fo$objdir/ $cflags /c $in
  description = Generating precompiled header $pchheader

rule copy
  command = copy /B /Y $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: ImGui_Debug

cflags_ImGui_Debug = /MTd /Z7
cxxflags_ImGui_Debug = /MTd /Z7 /std:c++17 /EHsc
ldflags_ImGui_Debug = /NOLOGO
objdir_ImGui_Debug = bin-int/Debug-windows-x86_64/ImGui
targetdir_ImGui_Debug = bin/Debug-windows-x86_64/ImGui
target_ImGui_Debug = ImGui.lib

build GT/vendor/ImGui/bin-int/Debug-windows-x86_64/ImGui/imgui.obj: cxx_msc GT/vendor/ImGui/imgui.cpp
  cxxflags = $cxxflags_ImGui_Debug
build GT/vendor/ImGui/bin-int/Debug-windows-x86_64/ImGui/imgui_demo.obj: cxx_msc GT/vendor/ImGui/imgui_demo.cpp
  cxxflags = $cxxflags_ImGui_Debug
build GT/vendor/ImGui/bin-int/Debug-windows-x86_64/ImGui/imgui_draw.obj: cxx_msc GT/vendor/ImGui/imgui_draw.cpp
  cxxflags = $cxxflags_ImGui_Debug
build GT/vendor/ImGui/bin-int/Debug-windows-x86_64/ImGui/imgui_tables.obj: cxx_msc GT/vendor/ImGui/imgui_tables.cpp
  cxxflags = $cxxflags_ImGui_Debug
build GT/vendor/ImGui/bin-int/Debug-windows-x86_64/ImGui/imgui_widgets.obj: cxx_msc GT/vendor/ImGui/imgui_widgets.cpp
  cxxflags = $cxxflags_ImGui_Debug
build GT/vendor/ImGui/bin/Debug-windows-x86_64/ImGui/ImGui.lib: ar_msc GT/vendor/ImGui/bin-int/Debug-windows-x86_64/ImGui/imgui.obj GT/vendor/ImGui/bin-int/Debug-windows-x86_64/ImGui/imgui_demo.obj GT/vendor/ImGui/bin-int/Debug-windows-x86_64/ImGui/imgui_draw.obj GT/vendor/ImGui/bin-int/Debug-windows-x86_64/ImGui/imgui_tables.obj GT/vendor/ImGui/bin-int/Debug-windows-x86_64/ImGui/imgui_widgets.obj

# Configuration: ImGui_Release

cflags_ImGui_Release = /Ot /MT
cxxflags_ImGui_Release = /Ot /MT /std:c++17 /EHsc
ldflags_ImGui_Release = /NOLOGO
objdir_ImGui_Release = bin-int/Release-windows-x86_64/ImGui
targetdir_ImGui_Release = bin/Release-windows-x86_64/ImGui
