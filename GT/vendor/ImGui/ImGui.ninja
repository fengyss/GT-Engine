  cxxflags = $cxxflags_ImGui_Release
build GT/vendor/ImGui/bin-int/Release-windows-x86_64/ImGui/imgui_widgets.obj: cxx_msc GT/vendor/ImGui/imgui_widgets.cpp
  cxxflags = $cxxflags_ImGui_Release
build GT/vendor/ImGui/bin/Release-windows-x86_64/ImGui/ImGui.lib: ar_msc GT/vendor/ImGui/bin-int/Release-windows-x86_64/ImGui/imgui.obj GT/vendor/ImGui/bin-int/Release-windows-x86_64/ImGui/imgui_demo.obj GT/vendor/ImGui/bin-int/Release-windows-x86_64/ImGui/imgui_draw.obj GT/vendor/ImGui/bin-int/Release-windows-x86_64/ImGui/imgui_tables.obj GT/vendor/ImGui/bin-int/Release-windows-x86_64/ImGui/imgui_widgets.obj

# Configuration: ImGui_Dist

cflags_ImGui_Dist = /MT
cxxflags_ImGui_Dist = /MT /std:c++17 /EHsc
ldflags_ImGui_Dist = /NOLOGO
objdir_ImGui_Dist = bin-int/Dist-windows-x86_64/ImGui
targetdir_ImGui_Dist = bin/Dist-windows-x86_64/ImGui
target_ImGui_Dist = ImGui.lib

build GT/vendor/ImGui/bin-int/Dist-windows-x86_64/ImGui/imgui.obj: cxx_msc GT/vendor/ImGui/imgui.cpp
