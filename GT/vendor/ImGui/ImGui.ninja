# ImGui project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_gcc
  command = gcc $cflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C source $in

rule cxx_gcc
  command = g++ $cxxflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C++ source $in

rule rc_gcc
  command = windres -i $in -o $out $resflags
  description = Compiling resource $in

rule ar_gcc
  command = ar -rcs $out $in
  description = Archiving static library $out

rule pch_gcc
  command = g++ -x c++-header $cflags -o $out -MD -MF $out.d -c $in
  description = Generating precompiled header $in
  depfile = $out.d

rule copy
  command = cp -f $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: ImGui_Debug

cflags_ImGui_Debug = -m64 -g
cxxflags_ImGui_Debug = -m64 -g -std=c++17
ldflags_ImGui_Debug = -m64 -L/usr/lib64
objdir_ImGui_Debug = ../../../bin-int/Debug-linux-x86_64/ImGui
targetdir_ImGui_Debug = ../../../bin/Debug-linux-x86_64/ImGui
target_ImGui_Debug = libImGui.a

build bin-int/Debug-linux-x86_64/ImGui/imgui.o: cxx_gcc GT/vendor/ImGui/imgui.cpp
  cxxflags = $cxxflags_ImGui_Debug
build bin-int/Debug-linux-x86_64/ImGui/imgui_demo.o: cxx_gcc GT/vendor/ImGui/imgui_demo.cpp
  cxxflags = $cxxflags_ImGui_Debug
build bin-int/Debug-linux-x86_64/ImGui/imgui_draw.o: cxx_gcc GT/vendor/ImGui/imgui_draw.cpp
  cxxflags = $cxxflags_ImGui_Debug
build bin-int/Debug-linux-x86_64/ImGui/imgui_tables.o: cxx_gcc GT/vendor/ImGui/imgui_tables.cpp
  cxxflags = $cxxflags_ImGui_Debug
build bin-int/Debug-linux-x86_64/ImGui/imgui_widgets.o: cxx_gcc GT/vendor/ImGui/imgui_widgets.cpp
  cxxflags = $cxxflags_ImGui_Debug
build bin/Debug-linux-x86_64/ImGui/libImGui.a: ar_gcc bin-int/Debug-linux-x86_64/ImGui/imgui.o bin-int/Debug-linux-x86_64/ImGui/imgui_demo.o bin-int/Debug-linux-x86_64/ImGui/imgui_draw.o bin-int/Debug-linux-x86_64/ImGui/imgui_tables.o bin-int/Debug-linux-x86_64/ImGui/imgui_widgets.o

# Configuration: ImGui_Release

cflags_ImGui_Release = -m64 -O2
cxxflags_ImGui_Release = -m64 -O2 -std=c++17
ldflags_ImGui_Release = -m64 -s -L/usr/lib64
objdir_ImGui_Release = ../../../bin-int/Release-linux-x86_64/ImGui
targetdir_ImGui_Release = ../../../bin/Release-linux-x86_64/ImGui
target_ImGui_Release = libImGui.a

build bin-int/Release-linux-x86_64/ImGui/imgui.o: cxx_gcc GT/vendor/ImGui/imgui.cpp
  cxxflags = $cxxflags_ImGui_Release
build bin-int/Release-linux-x86_64/ImGui/imgui_demo.o: cxx_gcc GT/vendor/ImGui/imgui_demo.cpp
  cxxflags = $cxxflags_ImGui_Release
build bin-int/Release-linux-x86_64/ImGui/imgui_draw.o: cxx_gcc GT/vendor/ImGui/imgui_draw.cpp
  cxxflags = $cxxflags_ImGui_Release
build bin-int/Release-linux-x86_64/ImGui/imgui_tables.o: cxx_gcc GT/vendor/ImGui/imgui_tables.cpp
  cxxflags = $cxxflags_ImGui_Release
build bin-int/Release-linux-x86_64/ImGui/imgui_widgets.o: cxx_gcc GT/vendor/ImGui/imgui_widgets.cpp
  cxxflags = $cxxflags_ImGui_Release
build bin/Release-linux-x86_64/ImGui/libImGui.a: ar_gcc bin-int/Release-linux-x86_64/ImGui/imgui.o bin-int/Release-linux-x86_64/ImGui/imgui_demo.o bin-int/Release-linux-x86_64/ImGui/imgui_draw.o bin-int/Release-linux-x86_64/ImGui/imgui_tables.o bin-int/Release-linux-x86_64/ImGui/imgui_widgets.o

# Configuration: ImGui_Dist

cflags_ImGui_Dist = -m64
cxxflags_ImGui_Dist = -m64 -std=c++17
ldflags_ImGui_Dist = -m64 -s -L/usr/lib64
objdir_ImGui_Dist = ../../../bin-int/Dist-linux-x86_64/ImGui
targetdir_ImGui_Dist = ../../../bin/Dist-linux-x86_64/ImGui
target_ImGui_Dist = libImGui.a

build bin-int/Dist-linux-x86_64/ImGui/imgui.o: cxx_gcc GT/vendor/ImGui/imgui.cpp
  cxxflags = $cxxflags_ImGui_Dist
build bin-int/Dist-linux-x86_64/ImGui/imgui_demo.o: cxx_gcc GT/vendor/ImGui/imgui_demo.cpp
  cxxflags = $cxxflags_ImGui_Dist
build bin-int/Dist-linux-x86_64/ImGui/imgui_draw.o: cxx_gcc GT/vendor/ImGui/imgui_draw.cpp
  cxxflags = $cxxflags_ImGui_Dist
build bin-int/Dist-linux-x86_64/ImGui/imgui_tables.o: cxx_gcc GT/vendor/ImGui/imgui_tables.cpp
  cxxflags = $cxxflags_ImGui_Dist
build bin-int/Dist-linux-x86_64/ImGui/imgui_widgets.o: cxx_gcc GT/vendor/ImGui/imgui_widgets.cpp
  cxxflags = $cxxflags_ImGui_Dist
build bin/Dist-linux-x86_64/ImGui/libImGui.a: ar_gcc bin-int/Dist-linux-x86_64/ImGui/imgui.o bin-int/Dist-linux-x86_64/ImGui/imgui_demo.o bin-int/Dist-linux-x86_64/ImGui/imgui_draw.o bin-int/Dist-linux-x86_64/ImGui/imgui_tables.o bin-int/Dist-linux-x86_64/ImGui/imgui_widgets.o

# Build targets

build ImGui_Debug: phony bin/Debug-linux-x86_64/ImGui/libImGui.a
build ImGui_Release: phony bin/Release-linux-x86_64/ImGui/libImGui.a
build ImGui_Dist: phony bin/Dist-linux-x86_64/ImGui/libImGui.a

# Project phony targets

build ImGui: phony bin/Debug-linux-x86_64/ImGui/libImGui.a

