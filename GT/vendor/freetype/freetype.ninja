# freetype project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_gcc
  command = gcc $cflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C source $in

rule cxx_gcc
  command = g++ $cxxflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C++ source $in

rule rc_gcc
  command = windres -i $in -o $out $resflags
  description = Compiling resource $in

rule ar_gcc
  command = ar -rcs $out $in
  description = Archiving static library $out

rule pch_gcc
  command = g++ -x c++-header $cflags -o $out -MD -MF $out.d -c $in
  description = Generating precompiled header $in
  depfile = $out.d

rule copy
  command = cp -f $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: freetype_Debug

cflags_freetype_Debug = -m64 -g
cxxflags_freetype_Debug = -m64 -g -std=c++17
ldflags_freetype_Debug = -m64 -L/usr/lib64
objdir_freetype_Debug = ../../../bin-int/Debug-linux-x86_64/freetype
targetdir_freetype_Debug = ../../../bin/Debug-linux-x86_64/freetype
target_freetype_Debug = libfreetype.a


# Configuration: freetype_Release

cflags_freetype_Release = -m64 -O2
cxxflags_freetype_Release = -m64 -O2 -std=c++17
ldflags_freetype_Release = -m64 -s -L/usr/lib64
objdir_freetype_Release = ../../../bin-int/Release-linux-x86_64/freetype
targetdir_freetype_Release = ../../../bin/Release-linux-x86_64/freetype
target_freetype_Release = libfreetype.a


# Configuration: freetype_Dist

cflags_freetype_Dist = -m64
cxxflags_freetype_Dist = -m64 -std=c++17
ldflags_freetype_Dist = -m64 -s -L/usr/lib64
objdir_freetype_Dist = ../../../bin-int/Dist-linux-x86_64/freetype
targetdir_freetype_Dist = ../../../bin/Dist-linux-x86_64/freetype
target_freetype_Dist = libfreetype.a


# Build targets

build freetype_Debug: phony bin/Debug-linux-x86_64/freetype/libfreetype.a
build freetype_Release: phony bin/Release-linux-x86_64/freetype/libfreetype.a
build freetype_Dist: phony bin/Dist-linux-x86_64/freetype/libfreetype.a

# Project phony targets

build freetype: phony bin/Debug-linux-x86_64/freetype/libfreetype.a

