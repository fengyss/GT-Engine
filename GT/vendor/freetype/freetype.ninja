# freetype project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_msc
  command = cl $cflags /nologo /showIncludes -c /Tc$in /Fo$out
  deps = msvc
  description = Compiling C source $in

rule cxx_msc
  command = cl $cxxflags /nologo /showIncludes -c /Tp$in /Fo$out
  deps = msvc
  description = Compiling C++ source $in

rule rc_msc
  command = rc /nologo /fo$out $in $resflags
  description = Compiling resource $in

rule ar_msc
  command = lib $in /nologo -OUT:$out
  description = Archiving static library $out

rule pch_msc
  command = cl /nologo /Yc$pchheader /Fp$out /Fo$objdir/ $cflags /c $in
  description = Generating precompiled header $pchheader

rule copy
  command = copy /B /Y $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: freetype_Debug

cflags_freetype_Debug = /MTd /Z7
cxxflags_freetype_Debug = /MTd /Z7 /std:c++17 /EHsc
ldflags_freetype_Debug = /NOLOGO
objdir_freetype_Debug = bin-int/Debug-windows-x86_64/freetype
targetdir_freetype_Debug = bin/Debug-windows-x86_64/freetype
target_freetype_Debug = freetype.lib


# Configuration: freetype_Release

cflags_freetype_Release = /Ot /MT
cxxflags_freetype_Release = /Ot /MT /std:c++17 /EHsc
ldflags_freetype_Release = /NOLOGO
objdir_freetype_Release = bin-int/Release-windows-x86_64/freetype
targetdir_freetype_Release = bin/Release-windows-x86_64/freetype
target_freetype_Release = freetype.lib


# Configuration: freetype_Dist

cflags_freetype_Dist = /MT
cxxflags_freetype_Dist = /MT /std:c++17 /EHsc
ldflags_freetype_Dist = /NOLOGO
objdir_freetype_Dist = bin-int/Dist-windows-x86_64/freetype
targetdir_freetype_Dist = bin/Dist-windows-x86_64/freetype
target_freetype_Dist = freetype.lib


# Build targets

build freetype_Debug: phony GT/vendor/freetype/bin/Debug-windows-x86_64/freetype/freetype.lib
build freetype_Release: phony GT/vendor/freetype/bin/Release-windows-x86_64/freetype/freetype.lib
build freetype_Dist: phony GT/vendor/freetype/bin/Dist-windows-x86_64/freetype/freetype.lib

# Project phony targets

build freetype: phony GT/vendor/freetype/bin/Debug-windows-x86_64/freetype/freetype.lib

