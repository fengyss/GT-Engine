build bin/Dist-linux-x86_64/Box2D/libBox2D.a: ar_gcc bin-int/Dist-linux-x86_64/Box2D/aabb.o bin-int/Dist-linux-x86_64/Box2D/arena_allocator.o bin-int/Dist-linux-x86_64/Box2D/array.o bin-int/Dist-linux-x86_64/Box2D/bitset.o bin-int/Dist-linux-x86_64/Box2D/body.o bin-int/Dist-linux-x86_64/Box2D/broad_phase.o bin-int/Dist-linux-x86_64/Box2D/constraint_graph.o bin-int/Dist-linux-x86_64/Box2D/contact.o bin-int/Dist-linux-x86_64/Box2D/contact_solver.o bin-int/Dist-linux-x86_64/Box2D/core.o bin-int/Dist-linux-x86_64/Box2D/distance.o bin-int/Dist-linux-x86_64/Box2D/distance_joint.o bin-int/Dist-linux-x86_64/Box2D/dynamic_tree.o bin-int/Dist-linux-x86_64/Box2D/geometry.o bin-int/Dist-linux-x86_64/Box2D/hull.o bin-int/Dist-linux-x86_64/Box2D/id_pool.o bin-int/Dist-linux-x86_64/Box2D/island.o bin-int/Dist-linux-x86_64/Box2D/joint.o bin-int/Dist-linux-x86_64/Box2D/manifold.o bin-int/Dist-linux-x86_64/Box2D/math_functions.o bin-int/Dist-linux-x86_64/Box2D/motor_joint.o bin-int/Dist-linux-x86_64/Box2D/mover.o bin-int/Dist-linux-x86_64/Box2D/physics_world.o bin-int/Dist-linux-x86_64/Box2D/prismatic_joint.o bin-int/Dist-linux-x86_64/Box2D/revolute_joint.o bin-int/Dist-linux-x86_64/Box2D/sensor.o bin-int/Dist-linux-x86_64/Box2D/shape.o bin-int/Dist-linux-x86_64/Box2D/solver.o bin-int/Dist-linux-x86_64/Box2D/solver_set.o bin-int/Dist-linux-x86_64/Box2D/table.o bin-int/Dist-linux-x86_64/Box2D/timer.o bin-int/Dist-linux-x86_64/Box2D/types.o bin-int/Dist-linux-x86_64/Box2D/weld_joint.o bin-int/Dist-linux-x86_64/Box2D/wheel_joint.o

