# GT project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_gcc
  command = gcc $cflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C source $in

rule cxx_gcc
  command = g++ $cxxflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C++ source $in

rule rc_gcc
  command = windres -i $in -o $out $resflags
  description = Compiling resource $in

rule ar_gcc
  command = ar -rcs $out $in
  description = Archiving static library $out

rule pch_gcc
  command = g++ -x c++-header $cflags -o $out -MD -MF $out.d -c $in
  description = Generating precompiled header $in
  depfile = $out.d

rule copy
  command = cp -f $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: GT_Debug

cflags_GT_Debug = -m64 -g -D"GT_PLATFORM_LINUX" -D"GLFW_INCLUDE_NONE" -D"YAML_CPP_STATIC_DEFINE" -D"GT_DEBUG" -IGT/src -IGT/vendor -IGT/vendor/spdlog/include -IGT/vendor/freetype -IGT/vendor/glm -IGT/vendor/ImGuizmo -IGT/vendor/mono/include -IGT/vendor/GLFW/include -IGT/vendor/Glad/include -IGT/vendor/ImGui -IGT/vendor/stb_image -IGT/vendor/yaml-cpp/include -IGT/vendor/Box2D/include -IGT/vendor/entt -IGT/vendor/assimp/include -IGT/vendor/efsw/include -IGT/vendor/json/include
cxxflags_GT_Debug = -m64 -g -std=c++17 -D"GT_PLATFORM_LINUX" -D"GLFW_INCLUDE_NONE" -D"YAML_CPP_STATIC_DEFINE" -D"GT_DEBUG" -IGT/src -IGT/vendor -IGT/vendor/spdlog/include -IGT/vendor/freetype -IGT/vendor/glm -IGT/vendor/ImGuizmo -IGT/vendor/mono/include -IGT/vendor/GLFW/include -IGT/vendor/Glad/include -IGT/vendor/ImGui -IGT/vendor/stb_image -IGT/vendor/yaml-cpp/include -IGT/vendor/Box2D/include -IGT/vendor/entt -IGT/vendor/assimp/include -IGT/vendor/efsw/include -IGT/vendor/json/include
ldflags_GT_Debug = -m64 -L. -Lvendor/mono/lib/linux -Lvendor/assimp/lib/linux -L/usr/lib64
links_GT_Debug = bin/Debug-linux-x86_64/efsw/libefsw.a bin/Debug-linux-x86_64/GLFW/libGLFW.a bin/Debug-linux-x86_64/Glad/libGlad.a bin/Debug-linux-x86_64/Box2D/libBox2D.a bin/Debug-linux-x86_64/yaml_cpp/libyaml_cpp.a bin/Debug-linux-x86_64/ImGui/libImGui.a -lGTScriptCore -llibcmt.lib -lopengl32.lib -lmono -lassimp
objdir_GT_Debug = ../bin-int/Debug-linux-x86_64/GT
targetdir_GT_Debug = ../bin/Debug-linux-x86_64/GT
target_GT_Debug = libGT.a

