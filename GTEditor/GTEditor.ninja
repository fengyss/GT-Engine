# GTEditor project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_msc
  command = cl $cflags /nologo /showIncludes -c /Tc$in /Fo$out
  deps = msvc
  description = Compiling C source $in

rule cxx_msc
  command = cl $cxxflags /nologo /showIncludes -c /Tp$in /Fo$out
  deps = msvc
  description = Compiling C++ source $in

rule rc_msc
  command = rc /nologo /fo$out $in $resflags
  description = Compiling resource $in

rule link_msc
  command = cl $in $links /link $ldflags /nologo /out:$out
  description = Linking target $out

rule pch_msc
  command = cl /nologo /Yc$pchheader /Fp$out /Fo$objdir/ $cflags /c $in
  description = Generating precompiled header $pchheader

rule copy
  command = copy /B /Y $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: GTEditor_Debug

cflags_GTEditor_Debug = /MTd /Z7 /D"GLFW_INCLUDE_NONE" /D"YAML_CPP_STATIC_DEFINE" /D"GT_PLATFORM_WINDOWS" /D"GT_BUILD_DLL" /D"GT_DEBUG" /IGTEditor/src /IGT/vendor/spdlog/include /IGT/src /IGT/vendor /IGT/vendor/ImGui /IGT/vendor/GLFW/include /IGT/vendor/entt /IGT/vendor/glm /IGT/vendor/Box2D/include /IGT/vendor/ImGuizmo /IGT/vendor/assimp/include /IGT/vendor/efsw/include /utf-8
cxxflags_GTEditor_Debug = /MTd /Z7 /std:c++17 /EHsc /D"GLFW_INCLUDE_NONE" /D"YAML_CPP_STATIC_DEFINE" /D"GT_PLATFORM_WINDOWS" /D"GT_BUILD_DLL" /D"GT_DEBUG" /IGTEditor/src /IGT/vendor/spdlog/include /IGT/src /IGT/vendor /IGT/vendor/ImGui /IGT/vendor/GLFW/include /IGT/vendor/entt /IGT/vendor/glm /IGT/vendor/Box2D/include /IGT/vendor/ImGuizmo /IGT/vendor/assimp/include /IGT/vendor/efsw/include /utf-8
ldflags_GTEditor_Debug = /NOLOGO /DEBUG /ignore:4099 /ignore:4006 /ignore:4286 /LIBPATH:"GT/vendor/assimp/lib/windows" /LIBPATH:"GT/vendor/vld" /LIBPATH:"GT/vendor/mono/lib/windows" /LIBPATH:"bin/Debug-windows-x86_64/gtest"
links_GTEditor_Debug = bin/Debug-windows-x86_64/GT/GT.lib GT/vendor/ImGui/bin/Debug-windows-x86_64/ImGui/ImGui.lib assimp-vc143-mt.lib mono-2.0-sgen.lib
objdir_GTEditor_Debug = ../bin-int/Debug-windows-x86_64/GTEditor
targetdir_GTEditor_Debug = ../bin/Debug-windows-x86_64/GTEditor
target_GTEditor_Debug = GTEditor.exe

build bin-int/Debug-windows-x86_64/GTEditor/EditorLayer.obj: cxx_msc GTEditor/src/EditorLayer.cpp
  cxxflags = $cxxflags_GTEditor_Debug
build bin-int/Debug-windows-x86_64/GTEditor/HazelEditorApp.obj: cxx_msc GTEditor/src/HazelEditorApp.cpp
  cxxflags = $cxxflags_GTEditor_Debug
build bin-int/Debug-windows-x86_64/GTEditor/AssetsPanel.obj: cxx_msc GTEditor/src/Panels/AssetsPanel.cpp
  cxxflags = $cxxflags_GTEditor_Debug
build bin-int/Debug-windows-x86_64/GTEditor/ContentBrowserPanel.obj: cxx_msc GTEditor/src/Panels/ContentBrowserPanel.cpp
  cxxflags = $cxxflags_GTEditor_Debug
build bin-int/Debug-windows-x86_64/GTEditor/SceneHierarchyPanel.obj: cxx_msc GTEditor/src/Panels/SceneHierarchyPanel.cpp
  cxxflags = $cxxflags_GTEditor_Debug
build bin-int/Debug-windows-x86_64/GTEditor/SpriteSheetPanel.obj: cxx_msc GTEditor/src/Panels/SpriteSheetPanel.cpp
  cxxflags = $cxxflags_GTEditor_Debug
build bin/Debug-windows-x86_64/GTEditor/GTEditor.exe: link_msc bin-int/Debug-windows-x86_64/GTEditor/EditorLayer.obj bin-int/Debug-windows-x86_64/GTEditor/HazelEditorApp.obj bin-int/Debug-windows-x86_64/GTEditor/AssetsPanel.obj bin-int/Debug-windows-x86_64/GTEditor/ContentBrowserPanel.obj bin-int/Debug-windows-x86_64/GTEditor/SceneHierarchyPanel.obj bin-int/Debug-windows-x86_64/GTEditor/SpriteSheetPanel.obj | bin/Debug-windows-x86_64/GT/GT.lib GT/vendor/ImGui/bin/Debug-windows-x86_64/ImGui/ImGui.lib
  ldflags = $ldflags_GTEditor_Debug
  links = $links_GTEditor_Debug

