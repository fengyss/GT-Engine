# GTEditor project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_gcc
  command = gcc $cflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C source $in

rule cxx_gcc
  command = g++ $cxxflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C++ source $in

rule rc_gcc
  command = windres -i $in -o $out $resflags
  description = Compiling resource $in

rule link_gcc
  command = g++ -o $out $in $links $ldflags
  description = Linking target $out

rule pch_gcc
  command = g++ -x c++-header $cflags -o $out -MD -MF $out.d -c $in
  description = Generating precompiled header $in
  depfile = $out.d

rule copy
  command = cp -f $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: GTEditor_Debug

cflags_GTEditor_Debug = -m64 -g -D"GLFW_INCLUDE_NONE" -D"YAML_CPP_STATIC_DEFINE" -D"GT_PLATFORM_LINUX" -D"GT_BUILD_DLL" -D"GT_DEBUG" -IGTEditor/src -IGT/vendor/spdlog/include -IGT/src -IGT/vendor -IGT/vendor/ImGui -IGT/vendor/GLFW/include -IGT/vendor/entt -IGT/vendor/glm -IGT/vendor/Box2D/include -IGT/vendor/ImGuizmo -IGT/vendor/assimp/include -IGT/vendor/efsw/include
cxxflags_GTEditor_Debug = -m64 -g -std=c++17 -D"GLFW_INCLUDE_NONE" -D"YAML_CPP_STATIC_DEFINE" -D"GT_PLATFORM_LINUX" -D"GT_BUILD_DLL" -D"GT_DEBUG" -IGTEditor/src -IGT/vendor/spdlog/include -IGT/src -IGT/vendor -IGT/vendor/ImGui -IGT/vendor/GLFW/include -IGT/vendor/entt -IGT/vendor/glm -IGT/vendor/Box2D/include -IGT/vendor/ImGuizmo -IGT/vendor/assimp/include -IGT/vendor/efsw/include
ldflags_GTEditor_Debug = -m64 -LGT/vendor/assimp/lib/linux -LGT/vendor/mono/lib/linux -Wl,-l:libassimp.so -Wl,-l:libmono-2.0.so.1 -L../GT/vendor/assimp/lib/linux -L../GT/vendor/vld -L../GT/vendor/mono/lib/linux -L../bin/Debug-linux-x86_64/gtest -L/usr/lib64
links_GTEditor_Debug = bin/Debug-linux-x86_64/GT/libGT.a bin/Debug-linux-x86_64/efsw/libefsw.a bin/Debug-linux-x86_64/GLFW/libGLFW.a bin/Debug-linux-x86_64/Glad/libGlad.a bin/Debug-linux-x86_64/Box2D/libBox2D.a bin/Debug-linux-x86_64/ImGui/libImGui.a bin/Debug-linux-x86_64/yaml_cpp/libyaml_cpp.a
objdir_GTEditor_Debug = ../bin-int/Debug-linux-x86_64/GTEditor
targetdir_GTEditor_Debug = ../bin/Debug-linux-x86_64/GTEditor
target_GTEditor_Debug = GTEditor

build bin-int/Debug-linux-x86_64/GTEditor/EditorLayer.o: cxx_gcc GTEditor/src/EditorLayer.cpp
  cxxflags = $cxxflags_GTEditor_Debug
build bin-int/Debug-linux-x86_64/GTEditor/HazelEditorApp.o: cxx_gcc GTEditor/src/HazelEditorApp.cpp
  cxxflags = $cxxflags_GTEditor_Debug
build bin-int/Debug-linux-x86_64/GTEditor/AssetsPanel.o: cxx_gcc GTEditor/src/Panels/AssetsPanel.cpp
  cxxflags = $cxxflags_GTEditor_Debug
build bin-int/Debug-linux-x86_64/GTEditor/ContentBrowserPanel.o: cxx_gcc GTEditor/src/Panels/ContentBrowserPanel.cpp
  cxxflags = $cxxflags_GTEditor_Debug
build bin-int/Debug-linux-x86_64/GTEditor/SceneHierarchyPanel.o: cxx_gcc GTEditor/src/Panels/SceneHierarchyPanel.cpp
  cxxflags = $cxxflags_GTEditor_Debug
build bin-int/Debug-linux-x86_64/GTEditor/SpriteSheetPanel.o: cxx_gcc GTEditor/src/Panels/SpriteSheetPanel.cpp
  cxxflags = $cxxflags_GTEditor_Debug
build bin/Debug-linux-x86_64/GTEditor/GTEditor: link_gcc bin-int/Debug-linux-x86_64/GTEditor/EditorLayer.o bin-int/Debug-linux-x86_64/GTEditor/HazelEditorApp.o bin-int/Debug-linux-x86_64/GTEditor/AssetsPanel.o bin-int/Debug-linux-x86_64/GTEditor/ContentBrowserPanel.o bin-int/Debug-linux-x86_64/GTEditor/SceneHierarchyPanel.o bin-int/Debug-linux-x86_64/GTEditor/SpriteSheetPanel.o | bin/Debug-linux-x86_64/GT/libGT.a bin/Debug-linux-x86_64/efsw/libefsw.a bin/Debug-linux-x86_64/GLFW/libGLFW.a bin/Debug-linux-x86_64/Glad/libGlad.a bin/Debug-linux-x86_64/Box2D/libBox2D.a bin/Debug-linux-x86_64/ImGui/libImGui.a bin/Debug-linux-x86_64/yaml_cpp/libyaml_cpp.a
  ldflags = $ldflags_GTEditor_Debug
  links = $links_GTEditor_Debug

