# GT workspace Ninja build file generated by Premake
ninja_required_version = 1.6

subninja GT/vendor/Box2D/Box2D.ninja
subninja GT/vendor/GLFW/GLFW.ninja
subninja GT/vendor/Glad/Glad.ninja
subninja GT/vendor/entt/ENTT.ninja
subninja GT/vendor/ImGui/ImGui.ninja
subninja GT/vendor/yaml-cpp/yaml_cpp.ninja
subninja GT/vendor/efsw/efsw.ninja
subninja GT/vendor/json/json.ninja
subninja GT/vendor/googletest/gtest.ninja
subninja GT/vendor/freetype/freetype.ninja
subninja GT/GT.ninja
subninja GTEditor/GTEditor.ninja
subninja Test/Test.ninja

# Default build target
default GTEditor_Debug

# Workspace configuration targets
build Debug: phony Box2D_Debug GLFW_Debug Glad_Debug ENTT_Debug ImGui_Debug yaml_cpp_Debug efsw_Debug json_Debug gtest_Debug freetype_Debug GT_Debug GTEditor_Debug Test_Debug
build Release: phony Box2D_Release GLFW_Release Glad_Release ENTT_Release ImGui_Release yaml_cpp_Release efsw_Release json_Release gtest_Release freetype_Release GT_Release GTEditor_Release Test_Release
build Dist: phony Box2D_Dist GLFW_Dist Glad_Dist ENTT_Dist ImGui_Dist yaml_cpp_Dist efsw_Dist json_Dist gtest_Dist freetype_Dist GT_Dist GTEditor_Dist Test_Dist
