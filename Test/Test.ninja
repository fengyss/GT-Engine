# Test project Ninja build file generated by Premake
ninja_required_version = 1.6

rule cc_gcc
  command = gcc $cflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C source $in

rule cxx_gcc
  command = g++ $cxxflags -c $in -o $out
  deps = gcc
  depfile = $out.d
  description = Compiling C++ source $in

rule rc_gcc
  command = windres -i $in -o $out $resflags
  description = Compiling resource $in

rule link_gcc
  command = g++ -o $out $in $links $ldflags
  description = Linking target $out

rule pch_gcc
  command = g++ -x c++-header $cflags -o $out -MD -MF $out.d -c $in
  description = Generating precompiled header $in
  depfile = $out.d

rule copy
  command = cp -f $in $out
  description = Copying file $in to $out

rule prebuild
  command = $prebuildcommands
  description = Running pre-build commands

rule prelink
  command = $prelinkcommands
  description = Running pre-link commands

rule postbuild
  command = $postbuildcommands
  description = Running post-build commands

rule custom
  command = $customcommand
  description = Running custom command: $customcommand

# Configuration: Test_Debug

cflags_Test_Debug = -m64 -g -D"GT_DEBUG" -IGTEditor/src -IGT/vendor/spdlog/include -IGT/src -IGT -IGT/vendor -IGT/vendor/entt -IGT/vendor/glm -IGT/vendor/Box2D/include -IGT/vendor/ImGuizmo -IGT/vendor/assimp/include -IGT/vendor/efsw/include -IGT/vendor/googletest/include /NODEFAULTLIB:msvcrtd.lib
cxxflags_Test_Debug = -m64 -g -std=c++17 -D"GT_DEBUG" -IGTEditor/src -IGT/vendor/spdlog/include -IGT/src -IGT -IGT/vendor -IGT/vendor/entt -IGT/vendor/glm -IGT/vendor/Box2D/include -IGT/vendor/ImGuizmo -IGT/vendor/assimp/include -IGT/vendor/efsw/include -IGT/vendor/googletest/include /NODEFAULTLIB:msvcrtd.lib
ldflags_Test_Debug = -m64 -L../bin/Debug-linux-x86_64/gtest -L/usr/lib64
links_Test_Debug = bin/Debug-linux-x86_64/GT/libGT.a bin/Debug-linux-x86_64/efsw/libefsw.a bin/Debug-linux-x86_64/GLFW/libGLFW.a bin/Debug-linux-x86_64/Glad/libGlad.a bin/Debug-linux-x86_64/Box2D/libBox2D.a bin/Debug-linux-x86_64/ImGui/libImGui.a bin/Debug-linux-x86_64/yaml_cpp/libyaml_cpp.a bin/Debug-linux-x86_64/gtest/libgtest.a
objdir_Test_Debug = ../bin-int/Debug-linux-x86_64/Test
targetdir_Test_Debug = ../bin/Debug-linux-x86_64/Test
target_Test_Debug = Test

build bin-int/Debug-linux-x86_64/Test/EventSystemTests.o: cxx_gcc Test/src/EventSystemTests.cc
  cxxflags = $cxxflags_Test_Debug
build bin-int/Debug-linux-x86_64/Test/Test.o: cxx_gcc Test/src/Test.cc
  cxxflags = $cxxflags_Test_Debug
build bin-int/Debug-linux-x86_64/Test/main.o: cxx_gcc Test/src/main.cc
  cxxflags = $cxxflags_Test_Debug
build bin/Debug-linux-x86_64/Test/Test: link_gcc bin-int/Debug-linux-x86_64/Test/EventSystemTests.o bin-int/Debug-linux-x86_64/Test/Test.o bin-int/Debug-linux-x86_64/Test/main.o | bin/Debug-linux-x86_64/GT/libGT.a bin/Debug-linux-x86_64/efsw/libefsw.a bin/Debug-linux-x86_64/GLFW/libGLFW.a bin/Debug-linux-x86_64/Glad/libGlad.a bin/Debug-linux-x86_64/Box2D/libBox2D.a bin/Debug-linux-x86_64/ImGui/libImGui.a bin/Debug-linux-x86_64/yaml_cpp/libyaml_cpp.a bin/Debug-linux-x86_64/gtest/libgtest.a
  ldflags = $ldflags_Test_Debug
  links = $links_Test_Debug

