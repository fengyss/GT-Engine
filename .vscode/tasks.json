{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Generate ninja files",
      "command": "${workspaceFolder}/vendor/premake/bin/premake5",
      "args": [
        "ninja"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Generate the ninja project used by the build tasks."
    },
    {
      "type": "shell",
      "label": "Build glfw (Debug)",
      "command": "ninja",
      "args": [
        "GLFW"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Generate ninja files",
      "dependsOrder": "sequence",
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "Build GTEditor (Debug)",
      "command": "ninja",
      "args": [
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Generate ninja files",
      "dependsOrder": "sequence",
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "Build Test (Debug)",
      "command": "ninja",
      "args": [
        "config=debug",
        "Test",
        "-j8"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Generate ninja files",
      "dependsOrder": "sequence",
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    }
  ]
}